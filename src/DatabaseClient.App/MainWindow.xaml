<mah:MetroWindow x:Class="DatabaseClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:DatabaseClient.App"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        xmlns:views="clr-namespace:DatabaseClient.App.Views"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}" 
        Icon="Resources/dbClient.ico"
        Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewConnectionCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewQueryTabCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
        <KeyBinding Key="H" Modifiers="Ctrl+Shift" Command="{Binding OpenQueryHistoryCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}" />
    </mah:MetroWindow.InputBindings>

    <mah:MetroWindow.Resources>
        <!-- ═══ Ribbon styles (Word 2024-like) ═══ -->
        <Style x:Key="RibbonLargeButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RibbonSmallButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RibbonGroupSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4,6,14"/>
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </mah:MetroWindow.Resources>

    <DockPanel LastChildFill="True">
        
        <!-- ═══ Ribbon (Word 2024-style) ═══ -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#18000000">
            <TabControl x:Name="RibbonTabControl" 
                        Background="Transparent" Padding="0" BorderThickness="0"
                        TabStripPlacement="Top">
                <TabControl.Resources>
                    <!-- Modern flat tab header style -->
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="#555"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" 
                                            Background="{TemplateBinding Background}" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                                        </Border.Effect>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2.5"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="False"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="Background" Value="#0A000000"/>
                                            <Setter Property="Foreground" Value="#333"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ══ FILE (Backstage-style dropdown) ══ -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="File" FontWeight="SemiBold"/>
                    </TabItem.Header>
                    <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="12,8" MinHeight="108">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- Group: Connection -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding NewConnectionCommand}" ToolTip="New Connection (Ctrl+Shift+N)" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DatabasePlus" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="New" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Connection" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Connection" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>

                            <!-- Group: Import/Export -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding ImportConnectionsCommand}" ToolTip="Import Connections" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Import" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Import" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExportConnectionsCommand}" ToolTip="Export Connections" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Export" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Export" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Connections" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>

                            <!-- Group: Settings / Exit -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="Settings (Ctrl+,)" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Cog" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Settings" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MenuExit_Click" ToolTip="Exit Application" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ExitToApp" Width="26" Height="26" HorizontalAlignment="Center" Foreground="#E53935"/>
                                            <TextBlock Text="Exit" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Application" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </TabItem>

                <!-- ══ HOME ══ -->
                <TabItem Header="Home" IsSelected="True">
                    <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="12,8" MinHeight="108">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- Group: New -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding NewConnectionCommand}" ToolTip="New Connection (Ctrl+Shift+N)" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DatabasePlus" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="New" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Connection" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding NewQueryTabCommand}" ToolTip="New Query (Ctrl+T)" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CodeBraces" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="New" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Query" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="New" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>

                            <!-- Group: Clipboard / Edit -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding CloseAllTabsCommand}" ToolTip="Close All Tabs" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="TabRemove" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Close" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="All" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Tabs" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>

                            <!-- Group: History / Snippets -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding OpenQueryHistoryCommand}" ToolTip="Query History (Ctrl+Shift+H)" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="History" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="History" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenSnippetsCommand}" ToolTip="SQL Snippets" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CodeBracesBox" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Snippets" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenProfileSharingCommand}" ToolTip="Share Profiles" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ShareVariant" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Share" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Profiles" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Library" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </TabItem>

                <!-- ══ TOOLS ══ -->
                <TabItem Header="Tools">
                    <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="12,8" MinHeight="108">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- Group: Compare -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding OpenDataComparisonCommand}" ToolTip="Compare Data" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Compare" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Data" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenSchemaComparisonCommand}" ToolTip="Compare Schema" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DatabaseSync" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Compare" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                            <TextBlock Text="Schema" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Comparison" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>

                            <!-- Group: Automation -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding OpenSchedulerCommand}" ToolTip="Task Scheduler" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CalendarClock" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Scheduler" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Automation" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource RibbonGroupSeparator}"/>

                            <!-- Group: System -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Button Command="{Binding ForceGarbageCollectionCommand}" ToolTip="Force Garbage Collection" Style="{StaticResource RibbonSmallButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Garbage Collection" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="System" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </TabItem>

                <!-- ══ VIEW ══ -->
                <TabItem Header="View">
                    <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="12,8" MinHeight="108">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- Group: Panels -->
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding OpenLogViewerCommand}" ToolTip="Application Logs" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="TextBoxSearchOutline" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Logs" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenDiagnosticsCommand}" ToolTip="Diagnostics &amp; About" Style="{StaticResource RibbonLargeButton}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="InformationOutline" Width="26" Height="26" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Diagnostics" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Information" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ═══ Bottom Status Bar ═══ -->
        <StatusBar DockPanel.Dock="Bottom" Height="28"
                   Background="{DynamicResource MahApps.Brushes.Accent}">
            <StatusBar.Foreground>
                <SolidColorBrush Color="White"/>
            </StatusBar.Foreground>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Memory" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding MemoryUsage, StringFormat='Mem: {0}'}" Margin="0,0,16,0"/>
                    <materialDesign:PackIcon Kind="Connection" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding ActiveConnectionCount, StringFormat='Connections: {0}'}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══ Main Content: Connection Tree + Tab Area ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Connection Tree Panel ─── -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Padding="10,8" 
                        Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connections" 
                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding NewConnectionCommand}" 
                                ToolTip="Add Connection" Padding="4"
                                Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search box -->
                <Border DockPanel.Dock="Top" Padding="8,4">
                    <TextBox Text="{Binding ConnectionFilter, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Filter connections..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="12" Padding="4,2"
                             mah:TextBoxHelper.Watermark="Filter connections..."/>
                </Border>
                
                <TreeView x:Name="ConnectionTree" 
                          ItemsSource="{Binding FilteredConnections}" 
                          BorderThickness="0"
                          Padding="4"
                          TreeViewItem.Expanded="ConnectionTreeItem_Expanded"
                          PreviewMouseLeftButtonDown="ConnectionTree_PreviewMouseLeftButtonDown"
                          PreviewMouseDoubleClick="ConnectionTree_PreviewMouseDoubleClick"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>

                        <!-- Connection Node -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:ConnectionNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="1">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Connect" Command="{Binding ConnectCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Power"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PowerOff"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Open New Query" Command="{Binding OpenNewQueryCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="CodeBraces"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Monitor Dashboard" Command="{Binding OpenMonitorCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="MonitorDashboard"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Edit Connection" Command="{Binding EditConnectionCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Pencil"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Duplicate Connection" Command="{Binding DuplicateConnectionCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ContentCopy"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete Connection" Command="{Binding DeleteConnectionCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Delete"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Refresh"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding ConnectionInfo.ColorTag, FallbackValue=#007ACC}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <materialDesign:PackIcon Kind="{Binding DatabaseTypeIcon}" Width="16" Height="16" 
                                                         VerticalAlignment="Center" Margin="0,0,4,0"
                                                         Foreground="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Accent}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TypeLabel, StringFormat=' [{0}]'}" 
                                           Foreground="{DynamicResource MahApps.Brushes.Gray5}" Margin="4,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- Database Node -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:DatabaseNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="1">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open New Query" Command="{Binding OpenNewQueryCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="CodeBraces"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New Table" Command="{Binding NewTableCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TablePlus"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Import Data..." Command="{Binding ImportDataCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DatabaseImport"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Export Data..." Command="{Binding ExportDataCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DatabaseExport"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Refresh"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <materialDesign:PackIcon Kind="Database" Width="16" Height="16" 
                                                         Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- Folder Node -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="1">
                                <materialDesign:PackIcon Kind="{Binding FolderIcon}" Width="16" Height="16"
                                                         Foreground="#F5A623"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Children.Count, StringFormat=' ({0})'}" 
                                           Foreground="{DynamicResource MahApps.Brushes.Gray5}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- Table Node (with Select Top) - expandable with Columns/Indexes -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:TableNodeViewModel}"
                                                   ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="1">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open Data" Command="{Binding OpenDataCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TableEye"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Select Top 100" Command="{Binding SelectTopCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TableSearch"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Design Table" Command="{Binding DesignTableCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TableEdit"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Export Data..." Command="{Binding ExportDataCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DatabaseExport"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Copy Name" Command="{Binding CopyNameCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ContentCopy"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <materialDesign:PackIcon Kind="Table" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- Object Node (Triggers, Sequences, Indexes with properties) -->
                        <DataTemplate DataType="{x:Type vm:ObjectNodeViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy Name" Command="{Binding CopyNameCommand}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <materialDesign:PackIcon Kind="{Binding ObjectTypeIcon}" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PropertiesSummary, StringFormat=' - {0}'}" 
                                           Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                           VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>

                        <!-- Leaf Tree Node -->
                        <DataTemplate DataType="{x:Type vm:TreeNodeViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy Name" Command="{Binding CopyNameCommand}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <materialDesign:PackIcon Kind="{Binding ObjectTypeIcon}" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <!-- ─── GridSplitter ─── -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" Background="Transparent"
                          Cursor="SizeWE"/>

            <!-- ─── Tab Area ─── -->
            <Grid Grid.Column="2">
                <TabControl x:Name="MainTabControl"
                            ItemsSource="{Binding Tabs}" 
                            SelectedItem="{Binding SelectedTab}"
                            Padding="0"
                            AllowDrop="True"
                            PreviewMouseLeftButtonDown="TabControl_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="TabControl_PreviewMouseMove"
                            Drop="TabControl_Drop"
                            DragOver="TabControl_DragOver">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Close" Command="{Binding RequestCloseCommand}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Close"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Close Other Tabs" 
                                                  Command="{Binding DataContext.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Close All Tabs" 
                                                  Command="{Binding DataContext.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                <materialDesign:PackIcon Width="14" Height="14" 
                                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Kind="{Binding TabIconKind, Converter={StaticResource StringToPackIconKindConverter}}"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="●" Foreground="Orange" FontSize="8" VerticalAlignment="Center"
                                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisConverter}}"
                                           Margin="0,0,4,0"/>
                                <Button Content="✕" 
                                        Command="{Binding RequestCloseCommand}" 
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        FontSize="10" Padding="4,2" Cursor="Hand"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.Resources>
                        <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                            <views:QueryTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:QueryHistoryTabViewModel}">
                            <views:QueryHistoryTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:TableDesignerTabViewModel}">
                            <views:TableDesignerTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:TableDataTabViewModel}">
                            <views:TableDataTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SnippetsTabViewModel}">
                            <views:SnippetsTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ChartTabViewModel}">
                            <views:ChartTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DiagramTabViewModel}">
                            <views:DiagramTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:LogViewerTabViewModel}">
                            <views:LogViewerTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:MonitorTabViewModel}">
                            <views:MonitorTabView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DiagnosticsTabViewModel}">
                            <views:DiagnosticsTabView />
                        </DataTemplate>
                    </TabControl.Resources>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
                
                <!-- Snackbar for notifications -->
                <materialDesign:Snackbar x:Name="MainSnackbar"
                                         MessageQueue="{materialDesign:MessageQueue}"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                         Margin="0,0,0,8"/>
            </Grid>

            <!-- Placeholder when no tabs open -->
            <Border Grid.Column="2" 
                    Visibility="{Binding HasNoTabs, Converter={StaticResource BoolToVisConverter}}"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="DatabaseSearch" Width="64" Height="64" 
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
                    <TextBlock Text="Database Client" FontSize="24" FontWeight="Light" 
                               HorizontalAlignment="Center" Margin="0,16,0,8"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
                    <TextBlock Text="Open a connection or create a new query to get started" 
                               FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Command="{Binding NewConnectionCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabasePlus" Margin="0,0,6,0"/>
                                <TextBlock Text="New Connection"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NewQueryTabCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CodeBraces" Margin="0,0,6,0"/>
                                <TextBlock Text="New Query"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
