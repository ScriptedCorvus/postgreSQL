<mah:MetroWindow x:Class="DatabaseClient.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        mc:Ignorable="d"
        Title="Settings"
        Width="750" Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        TitleCharacterCasing="Normal"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        d:DataContext="{d:DesignInstance Type=vm:SettingsDialogViewModel}">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── Category Navigation ─── -->
        <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="8,8,8,4"
                         Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="&#xE8B6; Search settings..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="12"/>
            <ListBox ItemsSource="{Binding FilteredCategories}" 
                     SelectedItem="{Binding SelectedCategory}"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="12,8">
                            <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Cog"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="General">
                                                <Setter Property="Kind" Value="CogOutline"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Appearance">
                                                <Setter Property="Kind" Value="Palette"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Editor">
                                                <Setter Property="Kind" Value="CodeBraces"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Data Grid">
                                                <Setter Property="Kind" Value="Table"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Query Execution">
                                                <Setter Property="Kind" Value="Play"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Query History">
                                                <Setter Property="Kind" Value="History"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Keyboard Shortcuts">
                                                <Setter Property="Kind" Value="Keyboard"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Backup &amp; Restore">
                                                <Setter Property="Kind" Value="BackupRestore"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Notifications">
                                                <Setter Property="Kind" Value="Bell"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
        </Border>

        <!-- ─── Options Panel ─── -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" Padding="24,16" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- General -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=General}">
                    <TextBlock Text="General Settings" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>
                    
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                              materialDesign:HintAssist.Hint="Language"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,12" Width="200" HorizontalAlignment="Left"/>

                    <CheckBox Content="Confirm before closing tabs with unsaved changes"
                              IsChecked="{Binding ConfirmCloseUnsaved}" Margin="0,8"/>
                    <CheckBox Content="Restore tabs from last session on startup"
                              IsChecked="{Binding RestoreLastSession}" Margin="0,8"/>
                    <CheckBox Content="Check for updates on startup"
                              IsChecked="{Binding CheckForUpdates}" Margin="0,8"/>

                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Collaboration" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Shared project directory for team collaboration (connections, snippets, templates):"
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SharedProjectDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsReadOnly="True" Margin="0,0,4,0"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseSharedDirectoryCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Grid.Column="2" ToolTip="Clear" Command="{Binding ClearSharedDirectoryCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="4,4">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Appearance}">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>

                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedTheme}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,16" Width="200" HorizontalAlignment="Left"/>

                    <TextBlock Text="Accent Color" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding AccentColorPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="36" Height="36" Margin="4" Cursor="Hand"
                                        Command="{Binding DataContext.SelectAccentColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignToolButton}">
                                    <Border Width="28" Height="28" CornerRadius="14">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding}"/>
                                        </Border.Background>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Custom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="120" HorizontalAlignment="Left"/>
                        <Border Grid.Column="2" Width="28" Height="28" CornerRadius="4" Margin="8,0,0,0"
                                BorderThickness="1" BorderBrush="Gray">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding AccentColor, FallbackValue=#1976D2}"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Editor -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Editor}">
                    <TextBlock Text="Editor Settings" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>

                    <TextBox Text="{Binding EditorFontFamily, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Font Family"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Font Size:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <mah:NumericUpDown Value="{Binding EditorFontSize}" Minimum="8" Maximum="48"
                                           Width="100" StringFormat="N0"/>
                    </StackPanel>

                    <CheckBox Content="Show line numbers" IsChecked="{Binding ShowLineNumbers}" Margin="0,8"/>
                    <CheckBox Content="Word wrap" IsChecked="{Binding WordWrap}" Margin="0,8"/>

                    <Separator Margin="0,16,0,8"/>
                    <TextBlock Text="Syntax Colors" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Keywords:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SyntaxKeywordColor, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Margin="0,4" HorizontalAlignment="Left"/>
                        <Border Grid.Row="0" Grid.Column="2" Width="20" Height="20" CornerRadius="3" Margin="4,4">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding SyntaxKeywordColor, FallbackValue=#0000FF}"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Strings:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SyntaxStringColor, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Margin="0,4" HorizontalAlignment="Left"/>
                        <Border Grid.Row="1" Grid.Column="2" Width="20" Height="20" CornerRadius="3" Margin="4,4">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding SyntaxStringColor, FallbackValue=#A31515}"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Grid.Row="2" Text="Comments:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SyntaxCommentColor, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Margin="0,4" HorizontalAlignment="Left"/>
                        <Border Grid.Row="2" Grid.Column="2" Width="20" Height="20" CornerRadius="3" Margin="4,4">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding SyntaxCommentColor, FallbackValue=#008000}"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Grid.Row="3" Text="Numbers:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SyntaxNumberColor, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Margin="0,4" HorizontalAlignment="Left"/>
                        <Border Grid.Row="3" Grid.Column="2" Width="20" Height="20" CornerRadius="3" Margin="4,4">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding SyntaxNumberColor, FallbackValue=#098658}"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Grid.Row="4" Text="Functions:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SyntaxFunctionColor, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Margin="0,4" HorizontalAlignment="Left"/>
                        <Border Grid.Row="4" Grid.Column="2" Width="20" Height="20" CornerRadius="3" Margin="4,4">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding SyntaxFunctionColor, FallbackValue=#795E26}"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Data Grid -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Data Grid}">
                    <TextBlock Text="Data Grid Settings" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>

                    <TextBox Text="{Binding NullDisplayText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="NULL Display Text"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Grid Font Size:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <mah:NumericUpDown Value="{Binding GridFontSize}" Minimum="8" Maximum="32"
                                           Width="100" StringFormat="N0"/>
                    </StackPanel>

                    <CheckBox Content="Alternating row colors" IsChecked="{Binding AlternatingRowColors}" Margin="0,8"/>
                </StackPanel>

                <!-- Query Execution -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Query Execution}">
                    <TextBlock Text="Query Execution" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Timeout (seconds):" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <mah:NumericUpDown Value="{Binding QueryTimeoutSeconds}" Minimum="0" Maximum="3600"
                                           Width="120" StringFormat="N0"/>
                        <TextBlock Text="(0 = no limit)" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Max rows returned:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <mah:NumericUpDown Value="{Binding MaxRowsReturned}" Minimum="100" Maximum="1000000"
                                           Width="120" StringFormat="N0"/>
                    </StackPanel>

                    <CheckBox Content="Auto-commit (execute each statement in its own transaction)"
                              IsChecked="{Binding AutoCommit}" Margin="0,8"/>
                </StackPanel>

                <!-- Query History -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Query History}">
                    <TextBlock Text="Query History" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>

                    <CheckBox Content="Save query history" IsChecked="{Binding SaveQueryHistory}" Margin="0,8,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Max history entries:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <mah:NumericUpDown Value="{Binding MaxHistoryEntries}" Minimum="10" Maximum="10000"
                                           Width="120" StringFormat="N0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Keyboard Shortcuts -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Keyboard Shortcuts}">
                    <TextBlock Text="Keyboard Shortcuts" FontSize="18" FontWeight="Light" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Reset All to Defaults" Command="{Binding ResetAllShortcutsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,4"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ShortcutConflictMessage}" Foreground="OrangeRed" 
                               Margin="0,0,0,8" FontWeight="SemiBold"
                               Visibility="{Binding ShortcutConflictMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>

                    <DataGrid ItemsSource="{Binding ShortcutItems}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding DisplayName}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Shortcut" Binding="{Binding CurrentShortcut, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            <DataGridTextColumn Header="Default" Binding="{Binding DefaultShortcut}" IsReadOnly="True" Width="120" Foreground="Gray"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="↺" ToolTip="Reset to default"
                                                Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4,0" FontSize="14"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Notifications -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Notifications}">
                    <TextBlock Text="Notifications" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>

                    <CheckBox Content="Show status bar notifications" 
                              IsChecked="{Binding ShowStatusBarNotifications}" Margin="0,8"/>
                    <CheckBox Content="Show toast/popup notifications" 
                              IsChecked="{Binding ShowToastNotifications}" Margin="0,8"/>
                    <CheckBox Content="Notify on query completion (when app not focused)" 
                              IsChecked="{Binding NotifyQueryCompletion}" Margin="0,8"/>
                    <CheckBox Content="Play sound on completion" 
                              IsChecked="{Binding PlaySoundOnCompletion}" Margin="0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Toast duration (seconds):" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <mah:NumericUpDown Value="{Binding ToastDurationSeconds}" Minimum="0" Maximum="30"
                                           Width="100" StringFormat="N0"/>
                        <TextBlock Text="(0 = manual dismiss)" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Backup & Restore -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource StringEqualsToVisConverter}, ConverterParameter=Backup &amp; Restore}">
                    <TextBlock Text="Backup &amp; Restore" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>

                    <!-- Create Backup -->
                    <TextBlock Text="Create Backup" FontSize="14" FontWeight="Medium" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding BackupName, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Backup name (optional)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="Include:" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox Content="Settings" IsChecked="{Binding BackupSettings}" Margin="0,0,16,4"/>
                        <CheckBox Content="Connections" IsChecked="{Binding BackupConnections}" Margin="0,0,16,4"/>
                        <CheckBox Content="Query History" IsChecked="{Binding BackupHistory}" Margin="0,0,16,4"/>
                        <CheckBox Content="Snippets" IsChecked="{Binding BackupSnippets}" Margin="0,0,16,4"/>
                        <CheckBox Content="Templates" IsChecked="{Binding BackupTemplates}" Margin="0,0,16,4"/>
                    </WrapPanel>

                    <Button Command="{Binding CreateBackupCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Left" Padding="16,6" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BackupRestore" Margin="0,0,6,0"/>
                            <TextBlock Text="Create Backup Now"/>
                        </StackPanel>
                    </Button>

                    <!-- Status -->
                    <TextBlock Text="{Binding BackupStatusMessage}" Foreground="{DynamicResource MahApps.Brushes.Accent}" 
                               Margin="0,0,0,16" TextWrapping="Wrap"
                               Visibility="{Binding BackupStatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Existing Backups -->
                    <TextBlock Text="Existing Backups" FontSize="14" FontWeight="Medium" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding FileSize}" IsReadOnly="True" Width="70"/>
                            <DataGridTemplateColumn Header="Type" IsReadOnly="True" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Manual"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                            <Setter Property="Text" Value="Auto"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Command="{Binding RestoreBackupCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="12,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Margin="0,0,4,0"/>
                                <TextBlock Text="Restore"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteBackupCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="OrangeRed"
                                Padding="12,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Separator Margin="0,0,0,16"/>

                    <!-- Reset to Factory -->
                    <TextBlock Text="Factory Reset" FontSize="14" FontWeight="Medium" Foreground="OrangeRed" Margin="0,0,0,8"/>
                    <TextBlock Text="This will delete all settings, connections, history, and snippets. A backup will be created automatically before reset." 
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                    <Button Command="{Binding ResetToFactoryCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="OrangeRed" BorderBrush="OrangeRed"
                            HorizontalAlignment="Left" Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Margin="0,0,6,0"/>
                            <TextBlock Text="Reset to Factory Defaults"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ─── Bottom Buttons ─── -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" 
                Padding="16,12" 
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
            <Grid>
                <Button Content="Reset to Defaults" 
                        Command="{Binding ResetToDefaultsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Command="{Binding ConfirmCommand}" 
                            IsDefault="True" Width="90" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="OkButton_Click"/>
                    <Button Content="Cancel" IsCancel="True" Width="90"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
