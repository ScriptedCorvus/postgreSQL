<mah:MetroWindow x:Class="DatabaseClient.App.Views.MigrationWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        Title="Database Migration Wizard" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TitleCharacterCasing="Normal"
        d:DataContext="{d:DesignInstance Type=vm:MigrationWizardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Step indicator ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Accent}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="1. Connections"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=1}"
                           Foreground="White" Margin="0,0,16,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,16,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="2. Tables"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=2}"
                           Foreground="White" Margin="0,0,16,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,16,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="3. Type Mapping"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=3}"
                           Foreground="White" Margin="0,0,16,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,16,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="4. Execute"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=4}"
                           Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- ═══ Step Content ═══ -->
        <Grid Grid.Row="1" Margin="16">

            <!-- ─── Step 1: Connections ─── -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=1}">
                <TextBlock Text="Select Source and Target" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                <GroupBox Header="Source" Margin="0,0,0,12" materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SourceConnection}"
                                  DisplayMemberPath="Name" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SourceDatabases}" SelectedItem="{Binding SourceDatabase}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Target" materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding TargetConnection}"
                                  DisplayMemberPath="Name" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding TargetDatabases}" SelectedItem="{Binding TargetDatabase}"/>
                    </Grid>
                </GroupBox>
            </StackPanel>

            <!-- ─── Step 2: Table Selection ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Select tables and migration options" FontSize="14" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox Content="Migrate Structure" IsChecked="{Binding MigrateStructure}" Margin="0,0,16,0"/>
                    <CheckBox Content="Migrate Data" IsChecked="{Binding MigrateData}" Margin="0,0,16,0"/>
                    <CheckBox Content="Truncate Target" IsChecked="{Binding TruncateTarget}"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Tables}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          materialDesign:DataGridAssist.CellPadding="8 4">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="Table Name" Binding="{Binding TableName}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ─── Step 3: Type Mapping ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=3}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Data type mappings (edit target types as needed):" FontSize="14" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding TypeMappings}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          materialDesign:DataGridAssist.CellPadding="8 4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Target Type" Binding="{Binding TargetType, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ─── Step 4: Execution ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=4}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"
                             Height="20" Margin="0,0,0,12"/>

                <TextBox Grid.Row="1" Text="{Binding MigrationLog, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </Grid>
        </Grid>

        <!-- ═══ Navigation ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,16">
            <Button Content="Previous" Command="{Binding PreviousCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowPreviousButton, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="{Binding NextButtonText}" Command="{Binding NextCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Close" Click="Close_Click"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
