<mah:MetroWindow x:Class="DatabaseClient.App.Views.SchemaComparisonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        Title="Schema Comparison &amp; Synchronization" Height="700" Width="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TitleCharacterCasing="Normal"
        d:DataContext="{d:DesignInstance Type=vm:SchemaComparisonViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Step indicator ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Accent}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="1. Select Databases"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=1}"
                           Foreground="White" Margin="0,0,20,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,20,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="2. Comparison Results"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=2}"
                           Foreground="White" Margin="0,0,20,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,20,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="3. Migration Script"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=3}"
                           Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- ═══ Step Content ═══ -->
        <Grid Grid.Row="1" Margin="16">

            <!-- ─── Step 1: Database Selection ─── -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=1}">
                <TextBlock Text="Select Source and Target Databases" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                <GroupBox Header="Source" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Connection:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SourceConnection}"
                                      DisplayMemberPath="Name" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding SourceDatabases}" SelectedItem="{Binding SourceDatabase}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Target" Margin="0,0,0,16"
                          materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Connection:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding TargetConnection}"
                                      DisplayMemberPath="Name" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding TargetDatabases}" SelectedItem="{Binding TargetDatabase}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Object Types to Compare" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <CheckBox Content="Tables" IsChecked="{Binding CompareTables}" Margin="0,0,20,0"/>
                        <CheckBox Content="Views" IsChecked="{Binding CompareViews}" Margin="0,0,20,0"/>
                        <CheckBox Content="Functions" IsChecked="{Binding CompareFunctions}" Margin="0,0,20,0"/>
                        <CheckBox Content="Indexes" IsChecked="{Binding CompareIndexes}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- ─── Step 2: Comparison Results ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Summary badges -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#4CAF50" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Foreground="White">
                            <Run Text="Only in Source: "/><Run Text="{Binding OnlyInSourceCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#F44336" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Foreground="White">
                            <Run Text="Only in Target: "/><Run Text="{Binding OnlyInTargetCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#FF9800" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Foreground="White">
                            <Run Text="Modified: "/><Run Text="{Binding DifferentCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#9E9E9E" CornerRadius="4" Padding="8,4">
                        <TextBlock Foreground="White">
                            <Run Text="Identical: "/><Run Text="{Binding IdenticalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{Binding ComparisonLog}" Margin="0,0,0,8" FontStyle="Italic" Opacity="0.7"/>

                <!-- Schema diffs list -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding SchemaDiffs}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          SelectedItem="{Binding SelectedDiff}"
                          materialDesign:DataGridAssist.CellPadding="8 4"
                          x:Name="SchemaGrid"
                          LoadingRow="SchemaGrid_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding ObjectType}" Width="80"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding ObjectName}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ─── Step 3: Migration Script ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=3}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="CREATE (new objects)" IsChecked="{Binding GenerateCreates}" Margin="0,0,16,0"/>
                    <CheckBox Content="ALTER (modified objects)" IsChecked="{Binding GenerateAlters}" Margin="0,0,16,0"/>
                    <CheckBox Content="DROP (extra in target)" IsChecked="{Binding GenerateDrops}"/>
                </StackPanel>

                <TextBox Grid.Row="1" Text="{Binding MigrationScript}" IsReadOnly="True"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         materialDesign:HintAssist.Hint="Migration script..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </Grid>
        </Grid>

        <!-- ═══ Navigation Buttons ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,16">
            <Button Content="Previous" Command="{Binding PreviousCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowPreviousButton, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="{Binding NextButtonText}" Command="{Binding NextCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Close" Click="Close_Click"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
