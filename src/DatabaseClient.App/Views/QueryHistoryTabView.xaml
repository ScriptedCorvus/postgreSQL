<UserControl x:Class="DatabaseClient.App.Views.QueryHistoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QueryHistoryTabViewModel}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── Toolbar ─── -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource MahApps.Brushes.Gray10}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         materialDesign:HintAssist.Hint="Search history..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="12" Padding="4,2" Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding LoadHistoryCommand}" ToolTip="Refresh"
                            Style="{StaticResource MaterialDesignToolButton}" Padding="6">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding ClearAllCommand}" ToolTip="Clear All History"
                            Style="{StaticResource MaterialDesignToolButton}" Padding="6">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── History List ─── -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderThickness="0">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy SQL" Command="{Binding CopySqlCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="ContentCopy"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open in Editor" Command="{Binding OpenInEditorCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="CodeBraces"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Delete" Command="{Binding DeleteEntryCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Delete"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="28">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Width="16" Height="16" HorizontalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="CheckCircle"/>
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*" MaxWidth="500">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionName}" Width="120"/>
                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="100"/>
                <DataGridTextColumn Header="Time" Binding="{Binding ExecutionTime, StringFormat='{}{0:F0} ms'}" Width="70"/>
                <DataGridTextColumn Header="Rows" Binding="{Binding RowsAffected}" Width="60"/>
                <DataGridTextColumn Header="Date" Binding="{Binding ExecutedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ─── Status Bar ─── -->
        <Border Grid.Row="2" Padding="8,4" Background="{DynamicResource MahApps.Brushes.Gray10}">
            <TextBlock>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text=" entries"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
