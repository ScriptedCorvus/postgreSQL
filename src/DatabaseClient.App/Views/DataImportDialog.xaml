<mah:MetroWindow x:Class="DatabaseClient.App.Views.DataImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        xmlns:local="clr-namespace:DatabaseClient.App.Views"
        Title="Import Data" Height="620" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TitleCharacterCasing="Normal"
        d:DataContext="{d:DesignInstance Type=vm:DataImportWizardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <mah:MetroWindow.Resources>
        <local:StepFontWeightConverter x:Key="StepFontWeightConverter"/>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Step indicator ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Accent}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="1. File" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=1}"
                           Foreground="White" Margin="0,0,20,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,20,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="2. Format" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=2}"
                           Foreground="White" Margin="0,0,20,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,20,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="3. Mapping" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=3}"
                           Foreground="White" Margin="0,0,20,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,20,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="4. Import" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=4}"
                           Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- ═══ Step Content ═══ -->
        <Grid Grid.Row="1" Margin="16">

            <!-- Step 1: File Selection -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=1}">
                <TextBlock Text="Select File" FontSize="18" FontWeight="Light" Margin="0,0,0,12"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseFile_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0" Padding="12,4"/>
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="File path..."
                             VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{x:Static vm:DataImportWizardViewModel.SupportedFormats}"
                              SelectedItem="{Binding SelectedFormat}" Width="120"/>
                    <Button Content="Preview" Command="{Binding LoadPreviewCommand}" Margin="16,0,0,0"
                            Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding PreviewStatus}" FontSize="11" Margin="0,0,0,8"
                           Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
                <DataGrid ItemsSource="{Binding PreviewData}" AutoGenerateColumns="True" MaxHeight="280"
                          IsReadOnly="True" CanUserAddRows="False" BorderThickness="1"
                          BorderBrush="LightGray" GridLinesVisibility="All"/>
            </StackPanel>

            <!-- Step 2: Format Configuration -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=2}">
                <TextBlock Text="Format Configuration" FontSize="18" FontWeight="Light" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Delimiter:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:DataImportWizardViewModel.CommonDelimiters}"
                              SelectedItem="{Binding CsvDelimiter}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Text="First row header:" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding HasHeader}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="Encoding:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:DataImportWizardViewModel.Encodings}"
                              SelectedItem="{Binding Encoding}" Width="120" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>

            <!-- Step 3: Column Mapping -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=3}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Column Mapping" FontSize="18" FontWeight="Light" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Target Table:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailableTargetTables}" SelectedItem="{Binding TargetTable}"
                              IsEditable="True" Width="200"/>
                    <CheckBox Content="Create if not exists" IsChecked="{Binding CreateTableIfNotExists}" Margin="16,0,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding ColumnMappings}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Include" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="Source Column" Binding="{Binding SourceColumn}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Target Column" Binding="{Binding TargetColumn, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding InferredType, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Step 4: Import Options & Execution -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=4}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Import Options" FontSize="18" FontWeight="Light" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Width="120"/>
                        <ComboBox ItemsSource="{x:Static vm:DataImportWizardViewModel.ImportModes}"
                                  SelectedItem="{Binding ImportMode}" Width="150"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Batch size:" VerticalAlignment="Center" Width="120"/>
                        <TextBox Text="{Binding BatchSize}" Width="80"/>
                    </StackPanel>
                    <CheckBox Content="Use transaction" IsChecked="{Binding UseTransaction}" Margin="0,0,0,4"/>
                    <CheckBox Content="Truncate table before import" IsChecked="{Binding TruncateBeforeImport}" Foreground="#E53935"/>
                </StackPanel>

                <!-- Progress -->
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ImportStatus}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Start Import" Command="{Binding StartImportCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Padding="16,4"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Log -->
                <GroupBox Grid.Row="3" Header="Import Log" Padding="0"
                          materialDesign:GroupBoxAssist.HeaderPadding="8,4">
                    <ListBox ItemsSource="{Binding ImportLog}" FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- ═══ Navigation Buttons ═══ -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="LightGray" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Next →" Command="{Binding NextStepCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="← Back" Command="{Binding PreviousStepCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
                <TextBlock/>
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
