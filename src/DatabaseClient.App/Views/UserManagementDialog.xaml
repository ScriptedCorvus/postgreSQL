<mah:MetroWindow x:Class="DatabaseClient.App.Views.UserManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        Title="User &amp; Permission Management" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TitleCharacterCasing="Normal"
        d:DataContext="{d:DesignInstance Type=vm:UserManagementViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Create User Section ═══ -->
        <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="Create User" Margin="0,0,0,12"
                  materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="username" Margin="0,0,16,4"/>
                <TextBlock Grid.Column="2" Grid.Row="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <PasswordBox Grid.Column="3" Grid.Row="0" x:Name="NewPasswordBox"
                             materialDesign:HintAssist.Hint="password" Margin="0,0,16,4"
                             PasswordChanged="NewPasswordBox_PasswordChanged"/>
                <Button Grid.Column="4" Grid.Row="0" Content="Create User" Command="{Binding CreateUserCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>

                <!-- PostgreSQL role options -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding IsPostgreSQL, Converter={StaticResource BoolToVisConverter}}">
                    <CheckBox Content="Can Login" IsChecked="{Binding CanLogin}" Margin="0,0,16,0"/>
                    <CheckBox Content="Can Create DB" IsChecked="{Binding CanCreateDb}" Margin="0,0,16,0"/>
                    <CheckBox Content="Superuser" IsChecked="{Binding IsSuperuser}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ═══ User List ═══ -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Users" Margin="0,0,6,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          materialDesign:DataGridAssist.CellPadding="6 3">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Login" Binding="{Binding CanLogin}" Width="50"
                                                Visibility="{Binding DataContext.IsPostgreSQL, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Converter={StaticResource BoolToVisConverter}}"/>
                        <DataGridCheckBoxColumn Header="Super" Binding="{Binding IsSuperuser}" Width="50"
                                                Visibility="{Binding DataContext.IsPostgreSQL, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Converter={StaticResource BoolToVisConverter}}"/>
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="80"
                                            Visibility="{Binding DataContext.IsMySql, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Converter={StaticResource BoolToVisConverter}}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Drop User" Command="{Binding DropUserCommand}"
                            Style="{StaticResource MaterialDesignFlatSecondaryButton}" Foreground="Red" Margin="0,0,8,0"/>
                    <Button Content="Refresh" Command="{Binding LoadUsersCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ═══ Permissions ═══ -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Permissions" Margin="6,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Permissions}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          materialDesign:DataGridAssist.CellPadding="6 3">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="*"/>
                        <DataGridTextColumn Header="Privilege" Binding="{Binding Privilege}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Grant All" Command="{Binding GrantPrivilegeCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                    <Button Content="Revoke All" Command="{Binding RevokePrivilegeCommand}"
                            Style="{StaticResource MaterialDesignFlatSecondaryButton}" Foreground="Red"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ═══ SQLite notice ═══ -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Visibility="{Binding IsSQLite, Converter={StaticResource BoolToVisConverter}}"
                   Text="SQLite does not support user management." FontStyle="Italic" Opacity="0.6"/>

        <!-- ═══ Status ═══ -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   FontStyle="Italic" Opacity="0.7"/>
    </Grid>
</mah:MetroWindow>
