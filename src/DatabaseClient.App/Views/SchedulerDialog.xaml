<mah:MetroWindow x:Class="DatabaseClient.App.Views.SchedulerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        Title="Task Scheduler" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TitleCharacterCasing="Normal"
        d:DataContext="{d:DesignInstance Type=vm:SchedulerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Create Task Section ═══ -->
        <GroupBox Grid.Row="0" Header="New Task" Margin="0,0,0,12"
                  materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Task name" Margin="0,0,16,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Type:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding TaskTypes}" SelectedItem="{Binding TaskType}"
                          Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Connection:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding TaskConnection}"
                          DisplayMemberPath="Name" Margin="0,0,16,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding TaskDatabase, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="database name" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Interval (min):" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,16,4"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Table/Path:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="export path / table" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Script:" VerticalAlignment="Top" Margin="0,0,8,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding ScriptContent, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         materialDesign:HintAssist.Hint="SQL script (for Script tasks)" Margin="0,0,16,0"/>
                <Button Grid.Row="3" Grid.Column="3" Content="Save Task" Command="{Binding SaveTaskCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Bottom"/>
            </Grid>
        </GroupBox>

        <!-- ═══ Task List ═══ -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  materialDesign:DataGridAssist.CellPadding="6 3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TaskType}" Width="80"/>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="60"/>
                <DataGridTextColumn Header="Interval" Binding="{Binding IntervalMinutes, StringFormat={}{0} min}" Width="80"/>
                <DataGridTextColumn Header="Last Run" Binding="{Binding LastRun, StringFormat={}{0:g}}" Width="140"/>
                <DataGridTextColumn Header="Next Run" Binding="{Binding NextRun, StringFormat={}{0:g}}" Width="140"/>
                <DataGridTextColumn Header="Last Status" Binding="{Binding LastStatus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Task Actions ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Run Now" Command="{Binding RunNowCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="Enable/Disable" Command="{Binding ToggleEnabledCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="Delete" Command="{Binding DeleteTaskCommand}"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}" Foreground="Red" Margin="0,0,8,0"/>
            <Button Content="Refresh" Command="{Binding RefreshTasksCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>

        <!-- ═══ Execution Log ═══ -->
        <TextBox Grid.Row="3" Text="{Binding ExecutionLog, Mode=OneWay}" IsReadOnly="True"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11"
                 materialDesign:HintAssist.Hint="Execution log..."
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <!-- ═══ Status ═══ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,8,0,0" FontStyle="Italic" Opacity="0.7"/>
    </Grid>
</mah:MetroWindow>
