<mah:MetroWindow x:Class="DatabaseClient.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Error"
        Width="560" Height="300"
        MinWidth="400" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        TitleCharacterCasing="Normal"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + Message -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:PackIcon x:Name="ErrorIcon" Kind="AlertCircle"
                                     Width="32" Height="32"
                                     Foreground="#E53935"
                                     VerticalAlignment="Top"
                                     Margin="0,0,12,0"/>
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="14"
                       VerticalAlignment="Center"
                       MaxWidth="460"/>
        </StackPanel>

        <!-- Expand/Collapse Details -->
        <ToggleButton x:Name="DetailsToggle" Grid.Row="1"
                      Style="{StaticResource MaterialDesignFlatButton}"
                      Content="Show Details"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,4"
                      Checked="DetailsToggle_Changed"
                      Unchecked="DetailsToggle_Changed"/>

        <!-- Technical Details -->
        <TextBox x:Name="DetailsTextBox" Grid.Row="2"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code,Consolas,Courier New"
                 FontSize="11"
                 Visibility="Collapsed"
                 Margin="0,0,0,8"
                 Background="{DynamicResource MaterialDesign.Brush.Card.Background}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CopyButton" Content="Copy to Clipboard"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0"
                    Click="CopyButton_Click"/>
            <Button x:Name="CloseButton" Content="OK"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsDefault="True"
                    MinWidth="80"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
