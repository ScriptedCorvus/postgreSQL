<UserControl x:Class="DatabaseClient.App.Views.QueryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QueryTabViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- SQL Editor -->
            <RowDefinition Height="*" MinHeight="100"/>
            <!-- Splitter -->
            <RowDefinition Height="Auto"/>
            <!-- Results -->
            <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- ═══ Query Toolbar ═══ -->
        <ToolBar Grid.Row="0">
            <Button Command="{Binding ExecuteQueryCommand}" ToolTip="Execute (Ctrl+Enter)" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Foreground="Green" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="Execute" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelExecutionCommand}" ToolTip="Cancel execution" Padding="8,4"
                    IsEnabled="{Binding IsExecuting}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Stop" Foreground="Red" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="Stop" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExplainQueryCommand}" ToolTip="Explain Query Plan" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileTree" Foreground="#FF9800" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="Explain" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock Text="Database:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox Text="{Binding SelectedDatabase, UpdateSourceTrigger=PropertyChanged}" 
                     Width="150" VerticalAlignment="Center"/>
            <Separator/>
            <Button Command="{Binding ExportCsvCommand}" ToolTip="Export to CSV" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDelimited" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="CSV" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportJsonCommand}" ToolTip="Export to JSON" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CodeJson" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="JSON" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportSqlCommand}" ToolTip="Export as INSERT statements" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DatabaseExport" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="SQL" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportExcelCommand}" ToolTip="Export to Excel (.xlsx)" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" Margin="0,0,4,0" Foreground="#217346"/>
                    <TextBlock Text="Excel" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <materialDesign:PopupBox ToolTip="More export formats" PlacementMode="BottomAndAlignLeftEdges"
                                     StaysOpen="False" Padding="8,4">
                <materialDesign:PopupBox.ToggleContent>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DotsHorizontal" Width="18" Height="18"/>
                    </StackPanel>
                </materialDesign:PopupBox.ToggleContent>
                <StackPanel Width="180">
                    <Button Command="{Binding ExportXmlCommand}" Content="Export to XML" HorizontalAlignment="Stretch"/>
                    <Button Command="{Binding ExportMarkdownCommand}" Content="Export to Markdown" HorizontalAlignment="Stretch"/>
                    <Button Command="{Binding ExportHtmlCommand}" Content="Export to HTML" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </materialDesign:PopupBox>
            <Separator/>
            <Button Command="{Binding VisualizeAsChartCommand}" ToolTip="Visualize results as chart" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="0,0,4,0" Foreground="#9C27B0"/>
                    <TextBlock Text="Chart" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- ═══ SQL Editor (AvalonEdit) ═══ -->
        <avalonEdit:TextEditor Grid.Row="1" 
                               x:Name="SqlEditor"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="14"
                               ShowLineNumbers="True"
                               SyntaxHighlighting="TSQL"
                               WordWrap="False"
                               Padding="4"
                               BorderThickness="0,0,0,1"
                               BorderBrush="LightGray"/>

        <!-- ═══ Splitter ═══ -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" 
                      Background="Transparent" Cursor="SizeNS"/>

        <!-- ═══ Results Area ═══ -->
        <TabControl Grid.Row="3" Padding="0">
            <!-- Results Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Table" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Results"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" x:Name="ResultsGrid"
                              ItemsSource="{Binding ResultData}" 
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              AlternatingRowBackground="#F5F5F5"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              SelectionUnit="CellOrRowHeader"
                              ClipboardCopyMode="IncludeHeader"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              BorderThickness="0"
                              FontFamily="Cascadia Code, Consolas, Courier New"
                              FontSize="12"
                              AutoGeneratingColumn="ResultsGrid_AutoGeneratingColumn">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="ContentCopy"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy All as CSV" Command="{Binding CopyAsCsvCommand}"/>
                                <MenuItem Header="Copy All as INSERT" Command="{Binding CopyAsInsertCommand}"/>
                                <Separator/>
                                <MenuItem Header="Export to CSV..." Command="{Binding ExportCsvCommand}"/>
                                <MenuItem Header="Export to JSON..." Command="{Binding ExportJsonCommand}"/>
                                <MenuItem Header="Export as SQL INSERT..." Command="{Binding ExportSqlCommand}"/>
                                <MenuItem Header="Export to Excel..." Command="{Binding ExportExcelCommand}"/>
                                <MenuItem Header="Export to XML..." Command="{Binding ExportXmlCommand}"/>
                                <MenuItem Header="Export to Markdown..." Command="{Binding ExportMarkdownCommand}"/>
                                <MenuItem Header="Export to HTML..." Command="{Binding ExportHtmlCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Status Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource MahApps.Brushes.Gray10}" 
                            Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="LightGray">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RowCount, StringFormat='Rows: {0}'}" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding ExecutionTimeText, StringFormat='Time: {0}'}" Margin="0,0,16,0"/>
                            <ProgressBar Width="100" Height="12" IsIndeterminate="{Binding IsExecuting}"
                                         Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisConverter}}"
                                         Margin="0,0,8,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Messages Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MessageText" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Messages"/>
                        <!-- Error badge -->
                        <Border Background="#E53935" CornerRadius="7" MinWidth="14" Height="14" 
                                Margin="4,0,0,0" Padding="3,0"
                                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="{Binding ErrorEntries.Count}" 
                                       Foreground="White" FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MaxHeight="200"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Structured Error List -->
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding ErrorEntries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              FontFamily="Cascadia Code, Consolas, Courier New"
                              FontSize="12"
                              Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisConverter}}"
                              MouseDoubleClick="ErrorGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16" 
                                                                 Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineDisplay}" Width="50"/>
                            <DataGridTextColumn Header="State" Binding="{Binding SqlState}" Width="60"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Message}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                                  Background="LightGray"
                                  Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Plain Messages Text -->
                    <TextBox Grid.Row="2"
                             Text="{Binding MessagesText, Mode=OneWay}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             Padding="8"
                             BorderThickness="0"/>
                </Grid>
            </TabItem>

            <!-- Query Plan Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileTree" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Query Plan"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" 
                             Text="{Binding QueryPlanText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             Padding="8"
                             BorderThickness="0"/>

                    <!-- Plan Summary -->
                    <Border Grid.Row="1" Background="{DynamicResource MahApps.Brushes.Gray10}" 
                            Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="LightGray">
                        <TextBlock x:Name="PlanSummaryText" FontSize="11" Foreground="Gray"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
