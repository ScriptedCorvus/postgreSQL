<UserControl x:Class="DatabaseClient.App.Views.TableDataTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <ToolBar Grid.Row="0">
            <Button Command="{Binding RefreshDataCommand}" ToolTip="Refresh" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,4,0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding AddNewRowCommand}" ToolTip="Add New Row" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0" Foreground="Green"/>
                    <TextBlock Text="Add Row" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="ApplyChanges_Click" ToolTip="Apply Pending Changes" Padding="6,4"
                    IsEnabled="{Binding PendingChangesCount, Converter={StaticResource IntToBoolConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0" Foreground="#2196F3"/>
                    <TextBlock Text="Apply Changes" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DiscardChangesCommand}" ToolTip="Discard All Changes" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Undo" Width="16" Height="16" Margin="0,0,4,0" Foreground="#FF9800"/>
                    <TextBlock Text="Discard" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <TextBlock Text="Pending:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBlock Text="{Binding PendingChangesCount}" VerticalAlignment="Center" FontWeight="Bold"
                       Foreground="#FF9800"/>
        </ToolBar>

        <!-- ═══ Filter Bar ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Filter" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="WHERE" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="400"
                         VerticalAlignment="Center" Margin="0,0,6,0"
                         materialDesign:HintAssist.Hint="e.g. age > 18 AND name LIKE '%John%'"/>
                <Button Command="{Binding ApplyFilterCommand}" Content="Apply" Padding="12,2"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,4,0"/>
                <Button Command="{Binding ClearFilterCommand}" Content="Clear" Padding="12,2"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Border>

        <!-- ═══ Data Grid ═══ -->
        <DataGrid Grid.Row="2" x:Name="MainDataGrid"
                  ItemsSource="{Binding Data}"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  SelectionUnit="CellOrRowHeader"
                  SelectionMode="Extended"
                  GridLinesVisibility="All"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  BorderThickness="0"
                  CellEditEnding="DataGrid_CellEditEnding"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  PreviewKeyDown="DataGrid_PreviewKeyDown"
                  LoadingRow="DataGrid_LoadingRow"
                  AutoGeneratingColumn="DataGrid_AutoGeneratingColumn">
            <DataGrid.RowValidationRules>
                <DataErrorValidationRule ValidatesOnTargetUpdated="True"/>
            </DataGrid.RowValidationRules>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete Row" Command="{Binding DeleteRowCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Delete" Foreground="#E53935"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Set NULL" Click="SetNull_Click">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Null"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Copy Row as INSERT" Click="CopyAsInsert_Click">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="ContentCopy"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- ═══ Pagination ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="8,4"
                BorderThickness="0,1,0,0" BorderBrush="LightGray">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rows per page:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{x:Static vm:TableDataTabViewModel.PageSizeOptions}"
                              SelectedItem="{Binding PageSize}"
                              Width="70" VerticalAlignment="Center" Margin="0,0,12,0"
                              SelectionChanged="PageSize_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding FirstPageCommand}" Content="⏮" ToolTip="First Page" Padding="8,2"
                            Style="{StaticResource MaterialDesignFlatButton}" FontSize="14"/>
                    <Button Command="{Binding PreviousPageCommand}" Content="◀" ToolTip="Previous Page" Padding="8,2"
                            Style="{StaticResource MaterialDesignFlatButton}" FontSize="14"/>
                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <Button Command="{Binding NextPageCommand}" Content="▶" ToolTip="Next Page" Padding="8,2"
                            Style="{StaticResource MaterialDesignFlatButton}" FontSize="14"/>
                    <Button Command="{Binding LastPageCommand}" Content="⏭" ToolTip="Last Page" Padding="8,2"
                            Style="{StaticResource MaterialDesignFlatButton}" FontSize="14"/>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}">
                        <Run Text="Total: "/>
                        <Run Text="{Binding TotalRows, Mode=OneWay}"/>
                        <Run Text=" rows"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="4" Background="{DynamicResource MahApps.Brushes.Gray10}"
                Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="LightGray">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,8,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="12"/>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12"
                           Foreground="#FF9800"
                           Visibility="{Binding HasPrimaryKey, Converter={StaticResource InverseBoolToVisConverter}}">
                    ⚠ No primary key detected — updates use all-column matching
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="2" Background="#40000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="6"/>
                <TextBlock Text="Loading data..." Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
