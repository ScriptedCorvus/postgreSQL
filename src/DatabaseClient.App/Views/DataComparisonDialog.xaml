<mah:MetroWindow x:Class="DatabaseClient.App.Views.DataComparisonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels"
        xmlns:local="clr-namespace:DatabaseClient.App.Views"
        Title="Data Comparison &amp; Synchronization" Height="700" Width="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TitleCharacterCasing="Normal"
        d:DataContext="{d:DesignInstance Type=vm:DataComparisonViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Step indicator ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Accent}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="1. Source &amp; Target"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=1}"
                           Foreground="White" Margin="0,0,20,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,20,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="2. Key &amp; Columns"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=2}"
                           Foreground="White" Margin="0,0,20,0" FontSize="14"/>
                <TextBlock Text="→" Foreground="White" Margin="0,0,20,0" FontSize="14" Opacity="0.5"/>
                <TextBlock Text="3. Results &amp; Sync"
                           FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontWeightConverter}, ConverterParameter=3}"
                           Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- ═══ Step Content ═══ -->
        <Grid Grid.Row="1" Margin="16">

            <!-- ─── Step 1: Source & Target Selection ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=1}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Source -->
                <TextBlock Grid.Row="0" Text="Source" FontSize="16" FontWeight="Bold" Margin="0,0,0,8">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="Green"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <GroupBox Grid.Row="1" Header="Source Connection" Margin="0,0,0,12"
                          materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SourceConnection}"
                                  DisplayMemberPath="Name" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding SourceDatabases}" SelectedItem="{Binding SourceDatabase}"
                                  Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="4" Text="Table:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="5" ItemsSource="{Binding SourceTables}" SelectedItem="{Binding SourceTable}"/>
                    </Grid>
                </GroupBox>

                <!-- Target -->
                <TextBlock Grid.Row="2" Text="Target" FontSize="16" FontWeight="Bold" Margin="0,8,0,8">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="#2196F3"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <GroupBox Grid.Row="3" Header="Target Connection" Margin="0,0,0,0"
                          materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding TargetConnection}"
                                  DisplayMemberPath="Name" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding TargetDatabases}" SelectedItem="{Binding TargetDatabase}"
                                  Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="4" Text="Table:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="5" ItemsSource="{Binding TargetTables}" SelectedItem="{Binding TargetTable}"/>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- ─── Step 2: Key & Column Selection ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Select key columns (for matching rows) and columns to compare:" 
                           FontSize="14" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Columns}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          materialDesign:DataGridAssist.CellPadding="8 4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Column Name" Binding="{Binding ColumnName}" IsReadOnly="True" Width="*"/>
                        <DataGridCheckBoxColumn Header="Key (PK)" Binding="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Compare" Binding="{Binding IsCompared, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ─── Step 3: Comparison Results & Sync ─── -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisConverter}, ConverterParameter=3}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- Summary -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#4CAF50" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Foreground="White">
                            <Run Text="Only in Source: "/>
                            <Run Text="{Binding OnlyInSourceCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#F44336" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Foreground="White">
                            <Run Text="Only in Target: "/>
                            <Run Text="{Binding OnlyInTargetCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#FF9800" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Foreground="White">
                            <Run Text="Modified: "/>
                            <Run Text="{Binding DifferentCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#9E9E9E" CornerRadius="4" Padding="8,4">
                        <TextBlock Foreground="White">
                            <Run Text="Identical: "/>
                            <Run Text="{Binding IdenticalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Log -->
                <TextBlock Grid.Row="1" Text="{Binding ComparisonLog}" Margin="0,0,0,8" FontStyle="Italic" Opacity="0.7"/>

                <!-- Results Grid with row coloring -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding ComparisonResults}" AutoGenerateColumns="True"
                          IsReadOnly="True" CanUserAddRows="False"
                          materialDesign:DataGridAssist.CellPadding="6 2"
                          x:Name="ResultsGrid"
                          LoadingRow="ResultsGrid_LoadingRow"/>

                <!-- Sync Options -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,4">
                    <CheckBox Content="INSERT (only in source)" IsChecked="{Binding SyncInserts}" Margin="0,0,16,0"/>
                    <CheckBox Content="UPDATE (modified)" IsChecked="{Binding SyncUpdates}" Margin="0,0,16,0"/>
                    <CheckBox Content="DELETE (only in target)" IsChecked="{Binding SyncDeletes}" Margin="0,0,16,0"/>
                    <Button Content="Generate Sync Script" Command="{Binding GenerateSyncScriptCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="16,0,0,0"/>
                </StackPanel>

                <!-- Sync Script -->
                <TextBox Grid.Row="4" Text="{Binding SyncScript}" IsReadOnly="True"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         materialDesign:HintAssist.Hint="Sync script will appear here..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </Grid>
        </Grid>

        <!-- ═══ Navigation Buttons ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,16">
            <Button Content="Previous" Command="{Binding PreviousCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"
                    Visibility="{Binding ShowPreviousButton, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="{Binding NextButtonText}" Command="{Binding NextCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Close" Click="Close_Click"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
