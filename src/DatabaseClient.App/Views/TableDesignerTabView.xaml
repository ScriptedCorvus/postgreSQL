<UserControl x:Class="DatabaseClient.App.Views.TableDesignerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:DatabaseClient.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <ToolBar Grid.Row="0">
            <TextBlock Text="Table Name:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" Width="200" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Separator/>
            <Button Command="{Binding GenerateSqlCommand}" ToolTip="Generate SQL script" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CodeBraces" Width="18" Height="18" Margin="0,0,4,0" Foreground="#2196F3"/>
                    <TextBlock Text="Generate SQL" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExecuteSqlCommand}" ToolTip="Execute generated SQL" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Foreground="Green" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="Execute" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- ═══ Tabs: Columns, Indexes, Foreign Keys ═══ -->
        <TabControl Grid.Row="1" Padding="4">
            <!-- Columns Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TableColumn" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Columns"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column action buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <Button Command="{Binding AddColumnCommand}" ToolTip="Add Column" Padding="6,2"
                                Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Column" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Columns Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Columns}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              SelectionUnit="FullRow"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            <DataGridComboBoxColumn Header="Data Type" Width="160"
                                                     SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                                     ItemsSource="{x:Static vm:TableDesignerTabViewModel.CommonDataTypes}"/>
                            <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="2" ToolTip="Remove column">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#E53935"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Indexes Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseSearch" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Indexes"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <Button Command="{Binding AddIndexCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Index" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Indexes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Index Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                            <DataGridTextColumn Header="Columns (comma-separated)" Binding="{Binding Columns, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Unique" Binding="{Binding IsUnique, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveIndexCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="2" ToolTip="Remove index">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#E53935"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Foreign Keys Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Foreign Keys"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <Button Command="{Binding AddForeignKeyCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Foreign Key" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ForeignKeys}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <DataGridTextColumn Header="Local Column" Binding="{Binding LocalColumn, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Referenced Table" Binding="{Binding ReferencedTable, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            <DataGridTextColumn Header="Referenced Column" Binding="{Binding ReferencedColumn, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridComboBoxColumn Header="On Delete" Width="100"
                                                     SelectedItemBinding="{Binding OnDelete, UpdateSourceTrigger=PropertyChanged}"
                                                     ItemsSource="{x:Static vm:TableDesignerTabViewModel.FkActions}"/>
                            <DataGridComboBoxColumn Header="On Update" Width="100"
                                                     SelectedItemBinding="{Binding OnUpdate, UpdateSourceTrigger=PropertyChanged}"
                                                     ItemsSource="{x:Static vm:TableDesignerTabViewModel.FkActions}"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveForeignKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="2" ToolTip="Remove FK">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#E53935"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Check Constraints Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Check Constraints"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <Button Command="{Binding AddCheckConstraintCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Check Constraint" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding CheckConstraints}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                            <DataGridTextColumn Header="Expression" Binding="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveCheckConstraintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="2" ToolTip="Remove Constraint">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#E53935"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ Splitter ═══ -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

        <!-- ═══ Generated SQL Preview ═══ -->
        <GroupBox Grid.Row="3" Header="Generated SQL" Padding="0" Margin="4,0,4,0"
                  materialDesign:GroupBoxAssist.HeaderPadding="8,4">
            <TextBox Text="{Binding GeneratedSql, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="12"
                     BorderThickness="0"/>
        </GroupBox>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="4" Background="{DynamicResource MahApps.Brushes.Gray10}"
                Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="LightGray">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
